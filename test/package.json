{
  "name": "test",
  "version": "1.0.0",
  "description": "Enterprise QA Framework - UI (POM), API (JSON Schema), DB, Contract (Pact), Performance (Artillery) with Allure Reports",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:all": "npm run test:ui && npm run test:api && npm run test:db && npm run test:contract && npm run test:performance:all",
    "test:db:playwright": "playwright test database --grep @db",
    "test:ui": "playwright test --grep @ui",
    "test:api": "playwright test api --grep @api",
    "test:db": "node database/run-db-tests.js",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "test:contract:consumer": "node contract/consumer/run-consumer.js",
    "test:contract:provider": "node contract/provider/run-provider.js",
    "test:performance": "node performance/run-artillery.js scenarios/load-test.yml && node performance/convert-artillery-to-allure.js",
    "test:performance:stress": "node performance/run-artillery.js scenarios/stress-test.yml && node performance/convert-artillery-to-allure.js",
    "test:performance:spike": "node performance/run-artillery.js scenarios/spike-test.yml && node performance/convert-artillery-to-allure.js",
    "test:performance:all": "npm run test:performance && npm run test:performance:stress && npm run test:performance:spike",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results",
    "report:clean": "rimraf allure-results allure-report",
    "report:history": "allure generate allure-results -o allure-report && allure open allure-report",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "testing",
    "playwright",
    "e2e",
    "api",
    "contract",
    "performance",
    "allure",
    "pom",
    "qa-automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "@pact-foundation/pact": "^12.1.0",
    "artillery": "^2.0.3",
    "bcrypt": "^5.1.1",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "@faker-js/faker": "^8.3.1",
    "winston": "^3.11.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "allure-playwright": "^2.10.0",
    "allure-commandline": "^2.25.0",
    "allure-mocha": "^2.0.0",
    "rimraf": "^5.0.5",
    "eslint": "^8.56.0",
    "mocha": "^10.2.0",
    "prisma": "^5.7.1"
  }
}
