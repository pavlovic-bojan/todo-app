{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Error Response Schema",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "stack": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

