{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Todo Schema",
  "type": "object",
  "required": ["id", "title", "completed", "userId", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "completed": {
      "type": "boolean"
    },
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "user": {
      "type": "object",
      "required": ["id", "username", "email"],
      "properties": {
        "id": {"type": "integer"},
        "username": {"type": "string"},
        "email": {"type": "string", "format": "email"}
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

