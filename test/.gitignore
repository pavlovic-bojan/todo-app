# ============================================
# TEST .gitignore - Test-specific artifacts
# Common patterns (node_modules, .env, etc.) are in root .gitignore
# ============================================

# Test Results & Reports
test-results/
playwright-report/
playwright/.cache/
allure-results/
allure-report/
allure-history/

# Pact Files (generated contracts)
pacts/
*.pact.json

# Screenshots & Videos (from test failures)
screenshots/
videos/
traces/

# Artillery Performance Reports
artillery-reports/
artillery-report.json

# Test databases (if any)
*.test.db
*.test.db-journal

# Test coverage
coverage/
.nyc_output/

